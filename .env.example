# --- Supabase → Prisma (required) ---
# Dashboard: Project Settings → Database → Connection string → URI
# Use "Session mode" / direct (port 5432) for migrations and prisma db push.
# For Vercel/serverless you may use the pooler (port 6543) with pgbouncer=true — follow Supabase docs.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase API (for @supabase/supabase-js if you add client-side features) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NextAuth — generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) — optional until you send mail
# RESEND_API_KEY: from resend.com/api-keys
# EMAIL_FROM: must be a real address Resend allows (verify your domain in Resend, then use e.g.
#   appointments@yourdomain.com
# Or with a display name (still a valid email on the right):
#   "Pinnacle Neurology Center <appointments@yourdomain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""
